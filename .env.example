# LearningOS environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real keys.

# Supabase project credentials (Dashboard -> Project Settings -> API)

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (safe for the browser - Row Level Security protects your data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key is intentionally NOT used by this app.
# If you ever need it for admin tasks, keep it server-side only and never expose it to the client.

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
# Server-side only: read by the /api/learning/youtube/search route, never exposed to the browser.
# Optional - without a key, YouTube learning resources are unavailable but the app keeps working.
YOUTUBE_API_KEY=

# NVIDIA NIM API key (build.nvidia.com -> API keys) for AI learning-path generation.
# Server-side only: read by the /api/learning/paths/generate route, never exposed to the browser.
# Optional - without a key, AI path generation is unavailable but the app keeps working.
NVIDIA_API_KEY=
